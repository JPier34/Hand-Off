# ─── Deployment / RPC ─────────────────────────────────────────────────────────
ALCHEMY_API_KEY=                          # Alchemy API key for RPC + contract deployment
PRIVATE_KEY=                              # Deployer wallet private key (testnet only)

# ─── Dynamic.xyz ──────────────────────────────────────────────────────────────
DYNAMIC_ENVIRONMENT_ID=                   # From app.dynamic.xyz → Developers → SDK & API Keys
VITE_DYNAMIC_ENVIRONMENT_ID=              # Same value — exposed to Vite browser build

# ─── Uniswap Trading API ──────────────────────────────────────────────────────
# Production: key injected server-side by netlify/functions/uniswap.mts — never in client bundle
UNISWAP_API_KEY=                          # From developer.uniswap.org (Netlify env, server-side only)
# Development: add to .env.local (gitignored) so the Vite dev server can authenticate
VITE_UNISWAP_API_KEY=                     # Same key — only used in `import.meta.env.DEV` builds

# ─── Contract Addresses (ETH Sepolia — chainId 11155111) ─────────────────────
# These are pre-filled with the live deployed addresses.
# Only override if you redeploy to a different network.
VITE_SUBNAME_ADDRESS=0x8e9568CF2F4Aa172DCDc91d320d96B964255226B

# ─── App Config ───────────────────────────────────────────────────────────────
CHAIN_ID=11155111
APP_NAME=Handoff
MOCK=false

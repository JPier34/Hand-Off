# =============================================================================
# HandOff — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored by default.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND / CONTRACTS (used by Hardhat scripts & deployment)
# -----------------------------------------------------------------------------

# Alchemy API key for RPC access (https://dashboard.alchemy.com)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Uniswap Routing / Quote API key (https://developer.uniswap.org)
UNISWAP_API_KEY=your_uniswap_api_key_here

# Dynamic.xyz environment ID (https://app.dynamic.xyz → Developers)
DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id_here

# WalletConnect project ID (https://cloud.walletconnect.com)
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Deployer wallet private key (without 0x prefix)
# WARNING: use a dedicated testnet-only wallet for this
PRIVATE_KEY=your_deployer_private_key_here

# Block explorer API keys — needed for contract verification (npx hardhat verify)
# Etherscan (ETH Sepolia): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Basescan (Base Sepolia): https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# -----------------------------------------------------------------------------
# FRONTEND (Vite exposes any VITE_* var to the browser bundle)
# Note: These mirror the values above but are prefixed for Vite's safety filter.
# -----------------------------------------------------------------------------

# Contract addresses after deployment (fill in post-deploy)
VITE_REPUTATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_SUBNAME_REGISTRAR_ADDRESS=0x0000000000000000000000000000000000000000

# Alchemy API key for frontend RPC calls
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Uniswap API key for frontend quote fetches
VITE_UNISWAP_API_KEY=your_uniswap_api_key_here

# Dynamic.xyz environment ID for the embedded wallet SDK
VITE_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id_here

# WalletConnect project ID for QR-code wallet connections
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
